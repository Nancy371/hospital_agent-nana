{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event_envelope_v1.schema.json",
  "title": "Trace Event Envelope v1",
  "type": "object",
  "required": [
    "event_id",
    "trace_id",
    "run_id",
    "case_id",
    "sequence",
    "event_type",
    "payload_schema_version",
    "stage",
    "component",
    "action",
    "round_id",
    "span_id",
    "parent_span_id",
    "status",
    "started_at",
    "ended_at",
    "duration_ms",
    "input_refs",
    "output_refs",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "run_id": {"type": "string"},
    "case_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {
      "type": "string",
      "enum": [
        "trace.started",
        "trace.completed",
        "trace.failed",
        "module.started",
        "module.completed",
        "module.failed",
        "artifact.created",
        "decision.made",
        "state.changed",
        "tool.called",
        "tool.returned",
        "tool.failed",
        "submission.created",
        "validation.failed"
      ]
    },
    "payload_schema_version": {"type": "string"},
    "stage": {"type": ["string", "null"]},
    "component": {"type": ["string", "null"]},
    "action": {"type": ["string", "null"]},
    "round_id": {"type": "string"},
    "span_id": {"type": ["string", "null"]},
    "parent_span_id": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "input_refs": {"type": "array"},
    "output_refs": {"type": "array"},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
